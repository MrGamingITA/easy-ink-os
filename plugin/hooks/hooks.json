{
  "description": "Calamaio: inoltra gli eventi delle sessioni al servizio locale (127.0.0.1:8765), che li mostra sul display e-ink. All'avvio, se il progetto non ha un avatar, lo dice a Claude (skill avatar); a un prompt, se il gioco della mascotte ha un accessorio speciale da creare, chiede a Claude di proporlo (skill accessorio).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "calamaio",
            "args": [
              "hook"
            ],
            "async": true
          },
          {
            "type": "command",
            "command": "calamaio",
            "args": [
              "hook",
              "--context"
            ],
            "timeout": 3
          }
        ]
      }
    ],
