{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calamaio.local/schema/theme.schema.json",
  "title": "Tema delle schermate (calamaio-theme v1)",
  "$comment": "Descrive solo la forma (docs/TEMI.md §1-§4). Le regole incrociate (font esistenti, valori nei testi, conteggi, riga.* solo nelle liste, ref row) stanno solo nel validatore Go (service/internal/theme).",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "name",
    "screen",
    "screens"
  ],
  "properties": {
    "format": {
      "const": "calamaio-theme"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 24,
      "not": {
        "const": "calamaio"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "screen": {
      "const": "250x122"
    },
    "screens": {
      "type": "object",
      "minProperties": 1,
