        "enum": [
          "home",
          "detail",
          "sleep",
          "offline",
          "riepilogo",
          "oggi",
          "batteria",
          "stato",
          "limiti",
          "focus",
          "ambiente",
          "pet"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/layout"
      }
    }
  },
